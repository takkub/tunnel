{
  "name": "tunnel-takkub",
  "version": "1.1.10",
  "description": "Cloudflare Tunnel Management Scripts",
  "main": "dist/index.js",
  "bin": {
    "tunnel": "bin/tunnel.js"
  },
  "files": [
    "bin/",
    "scripts/*.js",
    "web/.next/standalone/",
    "web/.next/static/",
    "web/public/",
    "docs/ops/npm-cli-package.md",
    ".env.example",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "web": "cd web && node node_modules/next/dist/bin/next build && node node_modules/next/dist/bin/next start -p 8888",
    "web:dev": "cd web && node node_modules/next/dist/bin/next dev",
    "web:start": "node scripts/web-serve.js start",
    "web:stop": "node scripts/web-serve.js stop",
    "menu": "node scripts/menu.js",
    "start": "docker-compose up -d",
    "stop": "docker-compose down",
    "test": "node scripts/run-tests.js",
    "verify": "npm --prefix web run typecheck && npm test",
    "check": "node scripts/check-requirements.js",
    "release": "node scripts/release.js",
    "login": "node scripts/login.js",
    "setup": "node scripts/setup-tunnel.js",
    "status": "node scripts/status.js",
    "delete": "node scripts/delete-tunnel.js",
    "cleanup": "node scripts/cleanup-tunnel.js",
    "check:dns": "node scripts/check-dns.js",
    "check:cnames": "node scripts/list-cnames.js",
    "cleanup:cnames": "node scripts/cleanup-all-cnames.js",
    "fix:dns": "node scripts/fix-app-dns.js",
    "delete:force": "node scripts/force-delete-tunnel.js",
    "delete:quick": "node scripts/quick-delete-tunnel.js",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:dist": "npm --prefix desktop run dist",
    "prepack": "npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "typescript": "^5.5.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
