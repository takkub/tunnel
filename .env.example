# Admin Panel Auth
# Password required to access the web UI — set a strong random string
ADMIN_PASSWORD=change-me-to-something-strong

# Secret key for signing the session cookie (HMAC-SHA256) — must be long and random
SESSION_SECRET=change-me-to-a-long-random-secret

# Cloudflare API Configuration
# Used by cleanup scripts for automatic CNAME record deletion

# API Token - Create at https://dash.cloudflare.com/profile/api-tokens
# Required permission: Zone.DNS.Edit
CLOUDFLARE_API_TOKEN=your-api-token-here

# Zone ID - Found on Cloudflare Dashboard → Select domain → right sidebar
ZONE_ID=your-zone-id-here

# Note:
# - If .env file is missing or these values are incorrect,
#   cleanup scripts will skip automatic CNAME deletion
#   and show instructions for manual removal instead.

# Cloudflare R2 Configuration (optional)
# Fallback used only when no R2 settings are stored via the Settings UI (settings.json wins)
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket-name
